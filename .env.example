# WorldScope configuration. `make setup` copies this to .env and fills every
# "change-me" value with a random secret. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=worldscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=worldscope
# Docker builds its own DATABASE_URL from the three values above. This one is
# only used when running the API or tests directly on your machine.
DATABASE_URL=postgresql+psycopg://worldscope:change-me@127.0.0.1:5432/worldscope

# --- Redis (task queue, cache, rate limits) -----------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- Security -----------------------------------------------------------------
# Signs sessions and tokens. 32+ random characters; production refuses anything shorter.
SECRET_KEY=change-me
# Comma-separated browser origins allowed to call the API directly. Empty = none.
CORS_ORIGINS=

# --- AI provider ----------------------------------------------------------------
# AI features stay off until a key is set. Keys never leave the backend.
# anthropic = Claude; none = AI features deliberately off.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_DEEP=claude-sonnet-5-5
# Non-essential AI work pauses for the day once this much has been spent.
AI_DAILY_BUDGET_USD=3

# --- Host ports (bound to 127.0.0.1 only) ---------------------------------------
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Production only --------------------------------------------------------------
# Public domain name; Caddy gets the HTTPS certificate for it.
DOMAIN=
